# Security Settings
# API_KEY=your_secret_api_key_here
# ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# ALLOWED_HOSTS=localhost,127.0.0.1

# LLM API Keys (OpenAI is kept but not used by default)
OPENROUTER_API_KEY=your_openrouter_key_here
OPENROUTER_API_BASE=https://openrouter.ai/api/v1
OR_SITE_URL=your_site_url_here
OR_APP_NAME=agent-market
GROQ_API_KEY=your_groq_key_here
GEMINI_API_KEY=your_gemini_key_here
CEREBRAS_API_KEY=your_cerebras_key_here
SAMBANOVA_API_KEY=your_sambanova_key_here
OPENAI_API_KEY=your_openai_key_here

# Vertex AI Configuration (For Free Credits / Enterprise Quota)
# Path to your Service Account JSON key
GOOGLE_APPLICATION_CREDENTIALS=credentials.json
VERTEXAI_PROJECT=your-gcp-project-id
VERTEXAI_LOCATION=us-central1

# OpenRouter model IDs (use full openrouter/<model> IDs)
OPENROUTER_MODEL_STRATEGIC=openrouter/meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_MODEL_ANALYTICAL=openrouter/mistralai/mistral-small-3.1-24b-instruct:free
OPENROUTER_MODEL_RULE=openrouter/mistralai/mistral-7b-instruct:free
OPENROUTER_MODEL_FAST=openrouter/meta-llama/llama-3.2-3b-instruct:free

# Provider rotation order (comma-separated)
MODEL_PROVIDER_ORDER=vertex_ai,cerebras,sambanova,groq,gemini,openrouter

# Simulation Settings
DEFAULT_MODEL=groq/llama-3.1-8b-instant
MARKET_DATABASE_PATH=market.db
CHROMA_DB_PATH=./chroma_db
